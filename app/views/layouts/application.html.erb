<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ChatRápido" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ChatRápido">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag 'favicon.ico' %>
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Load Farmácia UFMG Design System %>
    <link rel="stylesheet" href="https://design-system.farmacia.ufmg.br/dist/latest/farmacia-ds.min.css">
    <script src="https://design-system.farmacia.ufmg.br/dist/latest/farmacia-ds.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="ffds-root" data-current-sender-identifier="<%= session[:sender_identifier] %>" style="margin: 0; padding: 0; background-color: var(--color-gray-100); height: 100vh; display: flex; flex-direction: column; overflow: hidden;">
    <%= yield %>
  </body>
</html>

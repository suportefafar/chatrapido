<div id="<%= dom_id message %>" 
     class="d-flex flex-column gap-1 mb-2" 
     style="max-width: 85%; opacity: 0; transition: opacity 0.1s ease-in;" 
     data-controller="message-appearance clipboard"
     data-message-appearance-sender-identifier-value="<%= message.sender_identifier %>">
  
  <div class="px-3 py-2 position-relative" data-message-appearance-target="bubble">
    <% if message.file_message? %>
      <a href="<%= rails_blob_path(message.file, disposition: 'attachment') %>" 
         class="file-bubble-link text-decoration-none"
         data-clipboard-target="content"
         download>
        <div class="file-bubble d-flex align-items-center gap-3">
          <div class="file-bubble-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
              <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
            </svg>
          </div>
          <div class="file-bubble-info">
            <span class="file-bubble-name"><%= message.file.filename %></span>
            <span class="file-bubble-size"><%= number_to_human_size(message.file.byte_size) %></span>
          </div>
          <div class="file-bubble-download">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
              <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
              <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
            </svg>
          </div>
        </div>
      </a>
    <% else %>
      <div class="message-content" data-clipboard-target="content"><%= message.content %></div>
    <% end %>
  </div>

  <div class="d-flex align-items-center gap-2 px-2 opacity-75 mt-1">
    <span class="ds-caption fw-medium"><%= message.created_at.strftime("%H:%M") %></span>
    <% unless message.file_message? %>
      <button class="copy-button-small border-0 bg-transparent p-0" 
              style="color: var(--color-gray-500); line-height: 1;"
              data-clipboard-target="button" 
              data-action="click->clipboard#copy"
              title="Copiar mensagem">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
          <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
          <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
        </svg>
      </button>
    <% end %>
  </div>
</div>

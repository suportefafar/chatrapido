<div id="<%= dom_id message %>" 
     style="display: flex; flex-direction: column; max-width: 85%; opacity: 0; transition: opacity 0.1s ease-in; margin-bottom: var(--space-3);" 
     data-controller="message-appearance clipboard"
     data-message-appearance-sender-identifier-value="<%= message.sender_identifier %>">
  
  <div data-message-appearance-target="bubble" style="padding: var(--space-2) var(--space-3); width: fit-content; max-width: 100%; word-break: break-word; overflow-wrap: anywhere; white-space: pre-wrap; font-family: var(--font-body); font-size: var(--text-base); line-height: 1.5; box-shadow: var(--shadow-sm); min-width: 0;">
    <% if message.file_message? %>
      <a href="<%= rails_blob_path(message.file, disposition: 'attachment') %>" style="text-decoration: none; color: inherit; display: block;" download>
        <div style="display: flex; align-items: center; gap: var(--space-3);">
          <div style="display: flex; align-items: center; justify-content: center; padding: var(--space-2); background-color: rgba(0,0,0,0.05); border-radius: var(--radius-md); flex-shrink: 0;">
            <i data-lucide="file" style="width: 24px; height: 24px;"></i>
          </div>
          <div style="display: flex; flex-direction: column; min-width: 0;">
            <span style="font-weight: bold; font-size: var(--text-sm); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= message.file.filename %></span>
            <span style="font-size: var(--text-xs); opacity: 0.75;"><%= number_to_human_size(message.file.byte_size) %></span>
          </div>
          <div style="opacity: 0.75; display: flex; align-items: center; flex-shrink: 0;">
            <i data-lucide="download" style="width: 20px; height: 20px;"></i>
          </div>
        </div>
      </a>
    <% else %>
      <div data-clipboard-target="content" style="min-width: 0;"><%= message.content %></div>
    <% end %>
  </div>

  <div style="display: flex; align-items: center; gap: var(--space-2); padding: 0 var(--space-2); margin-top: var(--space-1); opacity: 0.75;">
    <span style="font-size: var(--text-xs); font-weight: bold;"><%= message.created_at.strftime("%H:%M") %></span>
    <% unless message.file_message? %>
      <button style="background: none; border: none; padding: 0; cursor: pointer; color: inherit; opacity: 0.7; display: flex; align-items: center; justify-content: center; transition: opacity 0.2s;"
              data-clipboard-target="button" 
              data-action="click->clipboard#copy"
              title="Copiar mensagem">
        <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
      </button>
    <% end %>
  </div>
</div>

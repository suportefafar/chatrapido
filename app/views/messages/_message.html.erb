<div id="<%= dom_id message %>" 
     class="d-flex flex-column mb-3"
     style="max-width: 85%; opacity: 0; transition: opacity 0.1s ease-in;" 
     data-controller="message-appearance clipboard"
     data-message-appearance-sender-identifier-value="<%= message.sender_identifier %>">
  
  <div data-message-appearance-target="bubble" class="p-2 px-3 shadow-sm rounded-3" style="width: fit-content; max-width: 100%; word-break: break-word; overflow-wrap: anywhere; min-width: 0;">
    <% if message.file_message? %>
      <a href="<%= rails_blob_path(message.file, disposition: 'attachment') %>" class="text-decoration-none text-reset d-block" download>
        <div class="d-flex align-items-center gap-3">
          <div class="d-flex align-items-center justify-content-center p-2 bg-black bg-opacity-10 rounded flex-shrink-0">
            <i class="bi bi-file-earmark fs-4"></i>
          </div>
          <div class="d-flex flex-column min-w-0" style="min-width: 0;">
            <span class="fw-bold small text-nowrap overflow-hidden text-truncate lh-sm"><%= message.file.filename %></span>
            <span class="small text-muted"><%= number_to_human_size(message.file.byte_size) %></span>
          </div>
          <div class="text-muted d-flex align-items-center flex-shrink-0 opacity-75">
            <i class="bi bi-download fs-5"></i>
          </div>
        </div>
      </a>
    <% else %>
      <div data-clipboard-target="content" style="min-width: 0; white-space: pre-wrap;"><%= message.content %></div>
    <% end %>
  </div>

  <div class="d-flex align-items-center gap-2 px-2 mt-1 text-muted">
    <span class="small fw-bold"><%= message.created_at.strftime("%H:%M") %></span>
    <% unless message.file_message? %>
      <button class="btn btn-link p-0 text-muted d-flex align-items-center justify-content-center"
              style="text-decoration: none;"
              data-clipboard-target="button" 
              data-action="click->clipboard#copy"
              title="Copiar mensagem">
        <i class="bi bi-copy" style="font-size: 0.875rem;"></i>
      </button>
    <% end %>
  </div>
</div>

<% content_for :title, "Início | ChatRápido" %>

<section style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; background-color: var(--color-secondary-dark); border-bottom: 4px solid var(--color-primary); overflow-y: auto;">
  <div style="width: 100%; max-width: 36rem; padding: var(--space-4);">
    <div style="margin-bottom: var(--space-4);">
      <%= image_tag 'icon.png', alt: "ChatRápido Logo", style: "max-height: 120px;" %>
    </div>
    
    <span style="display: inline-block; background-color: var(--color-primary); color: var(--color-secondary-dark); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-family: var(--font-mono); font-size: var(--text-sm); font-weight: bold; margin-bottom: var(--space-3);">Farmácia UFMG</span>
    
    <h1 style="color: var(--color-primary); font-family: var(--font-display); font-size: var(--text-5xl); margin-bottom: var(--space-3); margin-top: 0;">ChatRápido</h1>
    
    <p style="color: var(--color-white); font-family: var(--font-body); font-size: var(--text-lg); opacity: 0.8; margin-bottom: var(--space-6);">Comunicação efêmera, segura e instantânea para a comunidade acadêmica.</p>

    <%= button_to "Criar Nova Sala", rooms_path, class: "btn btn-success", style: "width: 100%; font-weight: bold; padding: var(--space-3) var(--space-4); font-size: var(--text-lg); margin-bottom: var(--space-6); justify-content: center;" %>

    <div style="display: flex; align-items: center; margin-bottom: var(--space-6);">
      <hr style="flex: 1; border: none; border-top: 1px solid rgba(255,255,255,0.2); margin: 0;">
      <span style="color: rgba(255,255,255,0.5); font-family: var(--font-mono); font-size: var(--text-sm); padding: 0 var(--space-3);">OU ENTRE EM UMA SALA</span>
      <hr style="flex: 1; border: none; border-top: 1px solid rgba(255,255,255,0.2); margin: 0;">
    </div>

    <%= form_with url: join_rooms_path, method: :post, style: "display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center;" do |form| %>
      <%= form.text_field :token, placeholder: "CÓDIGO DA SALA", maxlength: 6, style: "flex: 1; min-width: 200px; text-align: center; text-transform: uppercase; font-weight: bold; font-family: var(--font-mono); letter-spacing: 0.1em; font-size: var(--text-lg); border: none; border-radius: var(--radius-md); padding: var(--space-3); outline: none;" %>
      <%= form.submit "Entrar", class: "btn btn-primary", style: "font-weight: bold; padding: var(--space-3) var(--space-6);" %>
    <% end %>
  </div>
</section>

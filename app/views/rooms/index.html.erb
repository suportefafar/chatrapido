<div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center p-4" style="background-color: var(--color-primary); color: var(--color-secondary-dark);">
  <div class="ds-card w-100 text-center" style="max-width: 28rem; background: var(--color-white);">
    <div class="ds-hero-tag mb-4">Farmácia UFMG</div>
    <h1 class="ds-h1 mb-2 text-dark">ChatRapido</h1>
    <p class="ds-body-sm text-secondary mb-4">Mensagens efêmeras, anônimas e rápidas.</p>

    <%= button_to "Criar Nova Sala", rooms_path, class: "btn btn-secondary btn-lg w-100 fw-bold" %>

    <div class="ds-divider ds-divider-gold mx-auto w-100" style="position: relative; margin: var(--space-6) 0;">
      <span class="ds-caption" style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--color-white); padding: 0 var(--space-2);">OU</span>
    </div>

    <%= form_with url: join_rooms_path, method: :post do |form| %>
      <div class="form-group mb-0">
        <div class="input-wrap w-100 d-flex gap-2 align-items-stretch">
          <%= form.text_field :token, placeholder: "Código (Ex: A1B2C3)", class: "input input-lg text-center text-uppercase ds-mono", maxlength: 6 %>
          <%= form.submit "Entrar", class: "btn btn-secondary btn-lg fw-semibold" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

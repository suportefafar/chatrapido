<% content_for :title, "Início | ChatRápido" %>

<section class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center bg-white text-dark border-bottom border-4 border-warning overflow-auto">
  <div class="w-100 p-4" style="max-width: 36rem;">
    <div class="mb-4">
      <%= image_tag 'icon.png', alt: "ChatRápido Logo", style: "max-height: 120px;" %>
    </div>
    
    <span class="badge bg-warning text-dark rounded-pill font-monospace mb-3 px-3 py-1 fs-6">Farmácia UFMG</span>
    
    <h1 class="text-warning display-4 fw-bold mb-3 mt-0">ChatRápido</h1>
    
    <p class="text-muted fs-5 mb-5">Comunicação efêmera, segura e instantânea.</p>

    <%= button_to "Criar Nova Sala", rooms_path, class: "btn btn-success w-100 fw-bold py-3 fs-5 mb-5 d-flex justify-content-center" %>

    <div class="d-flex align-items-center mb-5">
      <hr class="flex-grow-1 border-dark opacity-25 m-0">
      <span class="text-muted font-monospace small px-3">OU ENTRE EM UMA SALA</span>
      <hr class="flex-grow-1 border-dark opacity-25 m-0">
    </div>

    <%= form_with url: join_rooms_path, method: :post, class: "d-flex flex-wrap gap-2 justify-content-center" do |form| %>
      <%= form.text_field :token, placeholder: "CÓDIGO DA SALA", maxlength: 6, class: "form-control form-control-lg text-center text-uppercase fw-bold font-monospace border bg-white", style: "flex: 1; min-width: 200px; letter-spacing: 0.1em;" %>
      <%= form.submit "Entrar", class: "btn btn-warning fw-bold px-5 py-3" %>
    <% end %>
  </div>
</section>

<% content_for :title, "Sala #{@room.token} | ChatRápido" %>

<div class="d-flex flex-column flex-grow-1 w-100 mx-auto bg-white shadow-sm overflow-hidden" style="max-width: 48rem;">
  <!-- Header -->
  <header class="flex-shrink-0 d-flex align-items-center justify-content-between p-3 bg-white text-dark border-bottom border-4 border-warning">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-white rounded p-1 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
        <%= image_tag 'icon.png', alt: "Icon", class: "img-fluid h-100" %>
      </div>
      <div class="d-flex flex-column overflow-hidden">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h2 class="m-0 fs-5 text-warning text-nowrap fw-bold">ChatRápido</h2>
          <span class="badge bg-warning bg-opacity-25 text-warning border border-warning px-2 py-1 rounded font-monospace text-nowrap">Sala <%= @room.token %></span>
        </div>
        <span class="text-secondary small text-nowrap">Expira em 24h sem uso</span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-3 flex-shrink-0">
      <%= link_to room_path(@room.token), class: "btn btn-outline-secondary btn-sm d-flex align-items-center gap-2", title: "Atualizar Mensagens" do %>
        <i class="bi bi-arrow-clockwise"></i> <span class="d-none d-sm-inline">Atualizar</span>
      <% end %>
      <button onclick="navigator.clipboard.writeText(window.location.href); alert('Link copiado!')" class="btn btn-warning btn-sm fw-bold d-flex align-items-center gap-2">
        <i class="bi bi-copy"></i> <span class="d-none d-sm-inline">Copiar Link</span>
      </button>
      <%= link_to "Sair", root_path, class: "text-dark text-decoration-none small fw-bold text-opacity-75" %>
    </div>
  </header>

  <!-- Messages Viewport -->
  <main id="messages_container" class="flex-grow-1 overflow-auto p-4 d-flex flex-column bg-white">
    <%= turbo_stream_from @room, target: "messages" %>
    <div id="messages" class="d-flex flex-column gap-3">
      <%= render @messages %>
    </div>
  </main>

  <!-- Footer Input -->
  <footer class="flex-shrink-0 bg-white border-top p-3">
    <%= form_with model: [@room, Message.new], url: room_messages_path(@room.token), 
                  html: { multipart: true, class: "d-flex flex-column gap-2 m-0" },
                  data: { 
                    controller: "reset-form chat-input file-upload", 
                    action: "turbo:submit-start->file-upload#submitStart turbo:submit-end->reset-form#reset turbo:submit-end->chat-input#reset turbo:submit-end->file-upload#reset" 
                  } do |form| %>
      
      <!-- File Preview Bar -->
      <div data-file-upload-target="preview" class="d-none d-flex align-items-center justify-content-between bg-white border rounded p-2">
        <div class="d-flex align-items-center gap-2 overflow-hidden">
          <i class="bi bi-file-earmark text-secondary flex-shrink-0"></i>
          <span data-file-upload-target="filename" class="fw-bold small text-nowrap overflow-hidden text-truncate"></span>
          <span data-file-upload-target="filesize" class="small text-secondary flex-shrink-0"></span>
        </div>
        <button type="button" data-action="click->file-upload#removeFile" class="btn btn-link text-secondary p-0 d-flex align-items-center justify-content-center">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <!-- Input Area -->
      <div class="d-flex align-items-end gap-2 bg-white border rounded p-1 shadow-sm">
        <%= form.file_field :file, class: "d-none", data: { file_upload_target: "input", action: "change->file-upload#fileSelected" }, accept: "*/*" %>
        
        <button type="button" data-action="click->file-upload#openFilePicker" title="Anexar arquivo" class="btn btn-link text-secondary p-2 d-flex align-items-center justify-content-center rounded flex-shrink-0">
          <i class="bi bi-paperclip fs-5"></i>
        </button>

        <%= form.text_area :content, placeholder: "Digite sua mensagem...", rows: 1, maxlength: 10000, data: { chat_input_target: "input", file_upload_target: "messageInput", action: "keydown->chat-input#handleKeydown input->chat-input#autoResize" }, class: "form-control border-0 bg-transparent p-2 shadow-none", style: "resize: none; max-height: 120px; min-width: 0;", autocomplete: "off" %>
        
        <div class="p-1 flex-shrink-0">
          <%= form.submit "Enviar", class: "btn btn-warning fw-bold rounded px-3 py-2 text-dark" %>
        </div>
      </div>
    <% end %>
  </footer>
</div>

<script>
  const container = document.getElementById('messages_container');
  if (container) {
    container.scrollTop = container.scrollHeight;
    const currentSender = document.body.dataset.currentSenderIdentifier;
    
    const observer = new MutationObserver((mutations) => {
      let hasNewExternalMessage = false;
      
      mutations.forEach(mutation => {
        mutation.addedNodes.forEach(node => {
          if (node.nodeType === Node.ELEMENT_NODE && node.hasAttribute('data-message-appearance-sender-identifier-value')) {
            const senderId = node.getAttribute('data-message-appearance-sender-identifier-value');
            if (senderId !== currentSender) {
              hasNewExternalMessage = true;
              
              const textContent = node.querySelector('[data-clipboard-target="content"]')?.innerText || "Novo arquivo anexado";
              
              if (document.hidden && "Notification" in window && Notification.permission === "granted") {
                new Notification("ChatRápido - Nova Mensagem", {
                  body: textContent,
                  icon: '/icon.png'
                });
              }
            }
          }
        });
      });
      
      if (hasNewExternalMessage) {
        playNotificationSound();
      }
      
      container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });
    });
    
    observer.observe(document.getElementById('messages'), { childList: true });
  }

  function playNotificationSound() {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const oscillator = audioCtx.createOscillator();
      const gainNode = audioCtx.createGain();
      
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(587.33, audioCtx.currentTime); 
      oscillator.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.1); 
      
      gainNode.gain.setValueAtTime(0, audioCtx.currentTime);
      gainNode.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.05);
      gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
      
      oscillator.connect(gainNode);
      gainNode.connect(audioCtx.destination);
      
      oscillator.start();
      oscillator.stop(audioCtx.currentTime + 0.3);
    } catch(e) {
      console.log("Audio notification blocked", e);
    }
  }
  
  if ("Notification" in window && Notification.permission === "default") {
    const requestPerm = () => {
      Notification.requestPermission();
      document.removeEventListener('click', requestPerm);
      document.removeEventListener('keydown', requestPerm);
    };
    document.addEventListener('click', requestPerm);
    document.addEventListener('keydown', requestPerm);
  }
</script>

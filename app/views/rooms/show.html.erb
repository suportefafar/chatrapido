<div class="flex-grow-1 d-flex flex-column h-100 bg-light mx-auto shadow-lg position-relative" style="max-width: 48rem; width: 100%;">
  <!-- Header -->
  <header class="ds-nav z-3 sticky-top" style="padding: var(--space-3) var(--space-4); border-bottom-width: 2px;">
    <div class="d-flex flex-column flex-grow-1">
      <div class="d-flex align-items-center gap-2">
        <h2 class="ds-nav-brand mb-0" style="font-size: var(--text-lg);">ChatRapido</h2>
        <span class="badge badge-neutral ds-mono">Sala <%= @room.token %></span>
      </div>
      <span class="ds-caption" style="color: var(--color-gray-300);">Expira em 24h sem uso</span>
    </div>
    <div class="d-flex align-items-center gap-3">
      <button onclick="navigator.clipboard.writeText(window.location.href); alert('Link copiado!')" class="btn btn-primary btn-sm fw-semibold shadow-sm">
        Copiar Link
      </button>
      <%= link_to "Sair", root_path, class: "text-white text-decoration-none fw-semibold small opacity-75 hover-opacity-100" %>
    </div>
  </header>

  <!-- Messages Output -->
  <div class="flex-grow-1 overflow-auto p-3 d-flex flex-column gap-3" id="messages_container" style="scroll-behavior: smooth;">
    <%= turbo_stream_from @room, target: "messages" %>
    <div id="messages" class="d-flex flex-column gap-3">
      <%= render @messages %>
    </div>
  </div>

  <!-- Footer Input -->
  <footer class="bg-white border-top p-3 sticky-bottom">
    <%= form_with model: [@room, Message.new], url: room_messages_path(@room.token), 
                  html: { multipart: true },
                  data: { 
                    controller: "reset-form chat-input file-upload", 
                    action: "turbo:submit-end->reset-form#reset turbo:submit-end->chat-input#reset turbo:submit-end->file-upload#reset" 
                  } do |form| %>
      
      <!-- File preview bar (hidden by default) -->
      <div class="file-preview-bar d-none mb-2 px-3 py-2 rounded-3 d-flex align-items-center justify-content-between"
           data-file-upload-target="preview" style="border-radius: var(--radius-md);">
        <div class="d-flex align-items-center gap-2 text-truncate">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0">
            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
          </svg>
          <span class="text-truncate fw-medium ds-body-sm" data-file-upload-target="filename"></span>
          <span class="text-secondary ds-caption flex-shrink-0" data-file-upload-target="filesize"></span>
        </div>
        <button type="button" class="btn-close ms-2" 
                data-action="click->file-upload#removeFile"
                aria-label="Remover arquivo">&times;</button>
      </div>

      <div class="input-wrap d-flex align-items-end shadow-sm rounded-4 border p-1 bg-white" style="border-radius: var(--radius-lg);">
        <!-- Hidden file input -->
        <%= form.file_field :file, 
                            class: "d-none", 
                            id: "file-input",
                            data: { 
                              file_upload_target: "input",
                              action: "change->file-upload#fileSelected" 
                            },
                            accept: "*/*" %>
        
        <!-- Attach file button -->
        <button type="button" 
                class="file-attach-btn border-0 rounded-3 px-3 py-2 ms-1 mb-1 d-flex align-items-center justify-content-center" 
                data-action="click->file-upload#openFilePicker"
                title="Anexar arquivo (máx. 25MB)">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
            <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0V3z"/>
          </svg>
        </button>

        <%= form.text_area :content, 
                           placeholder: "Digite sua mensagem...", 
                           class: "input border-0 bg-transparent py-2 px-3 no-focus-ring flex-grow-1", 
                           rows: 1,
                           data: { 
                             chat_input_target: "input",
                             file_upload_target: "messageInput",
                             action: "keydown->chat-input#handleKeydown input->chat-input#autoResize"
                           },
                           style: "resize: none; max-height: 200px; overflow-y: auto; box-shadow: none;",
                           autocomplete: "off" %>
        <%= form.submit "Enviar", class: "btn btn-primary fw-bold px-4 py-2 ms-2 mb-1", style: "border-radius: var(--radius-md);" %>
      </div>
    <% end %>
  </footer>
</div>
<script>
  const container = document.getElementById('messages_container');
  container.scrollTop = container.scrollHeight;
  const observer = new MutationObserver(() => {
    container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });
  });
  observer.observe(document.getElementById('messages'), { childList: true });
</script>

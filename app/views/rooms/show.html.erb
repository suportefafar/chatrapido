<% content_for :title, "Sala #{@room.token} | ChatRápido" %>

<div style="display: flex; flex-direction: column; height: 100vh; max-width: 48rem; margin: 0 auto; width: 100%; background-color: var(--color-gray-50); box-shadow: var(--shadow-md); overflow: hidden;">
  <!-- Header -->
  <header style="flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) var(--space-4); background-color: var(--color-secondary-dark); border-bottom: 4px solid var(--color-primary);">
    <div style="display: flex; align-items: center; gap: var(--space-3);">
      <div style="width: 40px; height: 40px; background-color: var(--color-white); border-radius: var(--radius-md); padding: var(--space-1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <%= image_tag 'icon.png', alt: "Icon", style: "max-width: 100%; max-height: 100%;" %>
      </div>
      <div style="display: flex; flex-direction: column; overflow: hidden;">
        <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
          <h2 style="margin: 0; font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-primary); white-space: nowrap;">ChatRápido</h2>
          <span style="background-color: var(--color-primary-20); color: var(--color-primary-light); padding: 2px 6px; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: bold; white-space: nowrap;">Sala <%= @room.token %></span>
        </div>
        <span style="color: var(--color-gray-400); font-size: var(--text-xs); white-space: nowrap;">Expira em 24h sem uso</span>
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: var(--space-3); flex-shrink: 0;">
      <button onclick="navigator.clipboard.writeText(window.location.href); alert('Link copiado!')" class="ffds-btn ffds-btn-primary" style="padding: var(--space-2) var(--space-3); font-size: var(--text-sm); font-weight: bold; display: flex; align-items: center; gap: var(--space-2);">
        <i data-lucide="copy" style="width: 16px; height: 16px;"></i> <span class="d-none d-sm-inline">Copiar Link</span>
      </button>
      <%= link_to "Sair", root_path, style: "color: var(--color-white); text-decoration: none; font-size: var(--text-sm); opacity: 0.8; font-weight: bold;" %>
    </div>
  </header>

  <!-- Messages Viewport -->
  <main id="messages_container" style="flex-grow: 1; overflow-y: auto; padding: var(--space-4); display: flex; flex-direction: column; background-color: var(--color-gray-50);">
    <%= turbo_stream_from @room, target: "messages" %>
    <div id="messages" style="display: flex; flex-direction: column; gap: var(--space-3);">
      <%= render @messages %>
    </div>
  </main>

  <!-- Footer Input -->
  <footer style="flex-shrink: 0; background-color: var(--color-white); border-top: 1px solid var(--border-color); padding: var(--space-3);">
    <%= form_with model: [@room, Message.new], url: room_messages_path(@room.token), 
                  html: { multipart: true, style: "display: flex; flex-direction: column; gap: var(--space-2); margin: 0;" },
                  data: { 
                    controller: "reset-form chat-input file-upload", 
                    action: "turbo:submit-end->reset-form#reset turbo:submit-end->chat-input#reset turbo:submit-end->file-upload#reset" 
                  } do |form| %>
      
      <!-- File Preview Bar -->
      <div data-file-upload-target="preview" class="d-none" style="display: flex; align-items: center; justify-content: space-between; background-color: var(--color-gray-100); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3);">
        <div style="display: flex; align-items: center; gap: var(--space-2); overflow: hidden;">
          <i data-lucide="file" style="width: 16px; height: 16px; color: var(--color-gray-500); flex-shrink: 0;"></i>
          <span data-file-upload-target="filename" style="font-size: var(--text-sm); font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></span>
          <span data-file-upload-target="filesize" style="font-size: var(--text-xs); color: var(--color-gray-500); flex-shrink: 0;"></span>
        </div>
        <button type="button" data-action="click->file-upload#removeFile" style="background: none; border: none; cursor: pointer; color: var(--color-gray-500); padding: 0; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="x" style="width: 16px; height: 16px;"></i>
        </button>
      </div>

      <!-- Input Area -->
      <div style="display: flex; align-items: flex-end; gap: var(--space-2); background-color: var(--color-white); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-1); box-shadow: var(--shadow-sm);">
        <%= form.file_field :file, class: "d-none", data: { file_upload_target: "input", action: "change->file-upload#fileSelected" }, accept: "*/*" %>
        
        <button type="button" data-action="click->file-upload#openFilePicker" title="Anexar arquivo" style="background: none; border: none; cursor: pointer; color: var(--color-gray-500); padding: var(--space-2); display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); flex-shrink: 0;">
          <i data-lucide="paperclip" style="width: 20px; height: 20px;"></i>
        </button>

        <%= form.text_area :content, placeholder: "Digite sua mensagem...", rows: 1, data: { chat_input_target: "input", file_upload_target: "messageInput", action: "keydown->chat-input#handleKeydown input->chat-input#autoResize" }, style: "flex: 1; border: none; background: transparent; padding: var(--space-2) 0; resize: none; max-height: 120px; overflow-y: auto; outline: none; font-family: var(--font-body); font-size: var(--text-base); margin: 0; min-width: 0;", autocomplete: "off" %>
        
        <div style="padding: var(--space-1); flex-shrink: 0;">
          <%= form.submit "Enviar", class: "ffds-btn ffds-btn-primary", style: "font-weight: bold; border-radius: var(--radius-md); padding: var(--space-2) var(--space-4);" %>
        </div>
      </div>
    <% end %>
  </footer>
</div>

<script>
  const container = document.getElementById('messages_container');
  if (container) {
    container.scrollTop = container.scrollHeight;
    const observer = new MutationObserver(() => {
      container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });
      if(window.FFDS && FFDS.createIcons) FFDS.createIcons({ icons: FFDS.icons });
    });
    observer.observe(document.getElementById('messages'), { childList: true });
  }
  document.addEventListener('turbo:load', () => {
    if(window.FFDS && FFDS.createIcons) FFDS.createIcons({ icons: FFDS.icons });
  });
</script>
